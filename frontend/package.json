{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:storybook": "vitest run --project storybook",
    "test:storybook:visible": "vitest run --project storybook --browser.headless=false --browser.fileParallelism=false",
    "test:storybook:trace": "vitest run --project storybook --browser.trace=on",
    "preview": "vite preview",
    "docs": "typedoc",
    "docs:open": "npx http-server typedoc -p 5050 -c-",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.87.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "recharts": "^3.2.0",
    "survey-core": "^2.3.8",
    "survey-react-ui": "^2.3.8",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.1",
    "@eslint/js": "^9.33.0",
    "@storybook/addon-a11y": "9.1.21",
    "@storybook/addon-docs": "9.1.21",
    "@storybook/addon-onboarding": "9.1.21",
    "@storybook/addon-vitest": "9.1.21",
    "@storybook/react-vite": "9.1.21",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "9.1.21",
    "globals": "^16.3.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.55.0",
    "prettier": "^3.6.2",
    "storybook": "9.1.21",
    "typedoc": "^0.28.12",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "^4.1.12"
  }
}
